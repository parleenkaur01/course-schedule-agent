{
  "manifest_version": 3,
  "name": "SDSU Course Schedule Agent",
  "description": "Plan sample course schedules and connect to the my.SDSU student homepage.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel"],
  "optional_permissions": ["scripting"],
  "optional_host_permissions": ["https://cmsweb.cms.sdsu.edu/*"],
  "action": { "default_title": "Open course scheduler" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "service-worker.js" }
}
